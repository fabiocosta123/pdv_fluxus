generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SaleStatus {
  COMPLETED
  CANCELED
}

enum PaymentMethod {
  MONEY
  PIX
  DEBIT
  CREDIT
  OTHER
  WALLET
}

enum CashierStatus {
  OPEN
  CLOSED
}

enum CashMovementType {
  SUPPLY
  WITHDRAWAL
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
}

enum LedgerEntryType {
  CHARGE
  PAYMENT
}

enum ExpenseCategory {
  FORNECEDOR
  ALUGUEL
  ENERGIA
  AGUA
  INTERNET
  SALARIOS
  OUTROS
}

enum ExpenseStatus {
  PENDING
  PAID
}

model Product {
  id        String     @id @default(cuid())
  name      String
  barCode   String?    @unique
  price     Int
  stock     Decimal    @default(0) @db.Decimal(10, 3)
  unit      String     @default("UN")
  ncm       String?
  costPrice Decimal    @default(0) @db.Decimal(65, 30)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  saleItems SaleItem[]
}

model Sale {
  id         String     @id @default(cuid())
  total      Int
  status     SaleStatus @default(COMPLETED)
  totalPaid  Int
  change     Int        @default(0)
  customerId       String?
  customer         Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cashierSessionId String?
  cashierSession   CashierSession? @relation(fields: [cashierSessionId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  items            SaleItem[]
  payments         Payment[]
  ledgerEntry      CustomerLedgerEntry?

  @@index([cashierSessionId])
  @@index([customerId])
}

model SaleItem {
  id          String  @id @default(cuid())
  saleId      String
  productId   String
  quantity    Decimal @db.Decimal(10, 3)
  priceAtSale Int
  name        String
  subtotal    Int
  sale        Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}

model Payment {
  id        String        @id @default(cuid())
  saleId    String
  method    PaymentMethod
  amount    Int
  value     Int
  createdAt DateTime      @default(now())
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
}

model Customer {
  id          String         @id @default(cuid())
  name        String
  document    String?        @unique
  birthDate   DateTime?      @db.Date
  phone       String?
  creditLimit Int?
  currentDebt Int            @default(0)
  status      CustomerStatus @default(ACTIVE)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  sales       Sale[]
  ledger      CustomerLedgerEntry[]
}

model CustomerLedgerEntry {
  id               String           @id @default(cuid())
  customerId       String
  customer         Customer         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  type             LedgerEntryType
  amount           Int
  balanceAfter     Int
  method           PaymentMethod?
  note             String?
  saleId           String?          @unique
  sale             Sale?            @relation(fields: [saleId], references: [id], onDelete: SetNull)
  cashierSessionId String?
  cashierSession   CashierSession?  @relation(fields: [cashierSessionId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())

  @@index([customerId, createdAt])
  @@index([cashierSessionId])
}

model CashierSession {
  id            String           @id @default(cuid())
  status        CashierStatus    @default(OPEN)
  openingValue  Int
  openedAt      DateTime         @default(now())
  closedAt      DateTime?
  countedMoney  Int?
  countedDebit  Int?
  countedCredit Int?
  countedPix    Int?
  countedWallet Int?
  movements     CashMovement[]
  sales         Sale[]
  ledgerEntries CustomerLedgerEntry[]
  expenses      Expense[]

  @@index([status])
  @@index([closedAt])
}

model CashMovement {
  id        String           @id @default(cuid())
  sessionId String
  type      CashMovementType
  amount    Int
  note      String?
  createdAt DateTime         @default(now())
  session   CashierSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

model Expense {
  id               String          @id @default(cuid())
  description      String
  category         ExpenseCategory
  amount           Int
  dueDate          DateTime        @db.Date
  status           ExpenseStatus   @default(PENDING)
  method           PaymentMethod?
  paidAt           DateTime?
  note             String?
  cashierSessionId String?
  cashierSession   CashierSession? @relation(fields: [cashierSessionId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([status, dueDate])
  @@index([paidAt])
  @@index([cashierSessionId])
}
